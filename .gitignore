# ==========================================================
# JobSight - .gitignore
# ==========================================================

############################
# Dependencies
############################
node_modules/

############################
# Build Output
############################
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo

############################
# Logs
############################
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

############################
# Runtime
############################
*.pid
*.seed
*.pid.lock

############################
# Environment Variables
############################
.env
.env.local
.env.development.local
.env.production.local
.env.test.local

############################
# Database
############################
data/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Keep directory structure
!data/.gitkeep

############################
# Runtime Hunts
############################
runs/
artifacts/
evidence/
cache/
temp/
tmp/

############################
# AGY
############################
.agy/
.agy-cache/
.agy-history/
.conversations/
.sessions/

############################
# Mission Logs
############################
mission-logs/
telemetry/
metrics/

############################
# Local User Profile
############################
profile/
candidate-profile.json
resume.pdf
resume.docx
resume.doc
portfolio.json

############################
# Uploads
############################
uploads/

############################
# Generated Reports
############################
reports/generated/
exports/
backups/

############################
# Testing
############################
.vitest/
playwright-report/
test-results/

############################
# VS Code
############################
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

############################
# JetBrains
############################
.idea/

############################
# macOS
############################
.DS_Store
.AppleDouble
.LSOverride

############################
# Windows
############################
Thumbs.db
Desktop.ini

############################
# Linux
############################
*~

############################
# Archives
############################
*.zip
*.tar
*.gz
*.rar
*.7z

############################
# Temporary Files
############################
*.tmp
*.temp
*.swp
*.swo

############################
# Secrets
############################
*.pem
*.key
*.crt
*.p12

############################
# API Keys
############################
credentials.json
service-account.json
google-service-account.json

############################
# Local Config
############################
config.local.*
settings.local.*

# AGY probe outputs
m2-probe-results.json

update_schema.ts